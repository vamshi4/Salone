# Without this, `COPY . .` in the Dockerfile overwrites the container's fresh
# `npm install` with whatever node_modules the host happens to have — which
# breaks the build when the host tree carries native binaries for a different
# platform. CI only avoided this because actions/checkout starts clean.
node_modules
.next
.git
.env
.env.*
tsconfig.tsbuildinfo
npm-debug.log*
